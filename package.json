{
  "name": "rdw-open-data-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A connected, visual dashboard over the RDW (Dutch Vehicle Authority) open data platform.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "verify:datasets": "node scripts/verify-datasets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "screenshots": "node tools/screenshots.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.7"
  }
}
